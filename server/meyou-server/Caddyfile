# {$DOMAIN}, {$HTTP_PORT} and {$HTTPS_PORT} come from the environment (docker-compose passes them in).
# Caddy gets and renews the HTTPS certificate by itself.
# NOTE: Let's Encrypt always checks through PUBLIC port 80 (HTTP challenge). Custom ports here only work
# for the certificate if the provider/router forwards public port 80 to HTTP_PORT.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN}:{$HTTPS_PORT:443} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy meyou-server:8080
}
