# meYou server 2.0: copy to .env and edit (docker compose and setup.sh read it).
# Only DOMAIN is required.

# Public host name (no https://, no path). A DNS A record must point at this server.
DOMAIN=meyou.example.com

# Where the server keeps its data on the VPS (db/ and backups/). Owned by uid 1000.
MEYOU_DATA_DIR=/srv/meyou

# Name shown in the app.
SERVER_NAME=meYou

# --- Ports (only when 80/443 are taken) ---------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_URL=https://meyou.example.com:8443

# --- Encrypted queue (the only phone-to-phone channel) -------------------------------
# Requests per minute per IP on /e2e/*. 1200 = a 200 MB video (about 270 chunks) with 8 chunks in flight, 2x headroom.
MAILBOX_RATE_LIMIT_MAX=1200
# Largest single encrypted blob in KB. Keep it at or under 1024 (1 MB ceiling).
E2E_MAX_BLOB_KB=1024
# A blob the partner never fetched is deleted after this many days.
E2E_TTL_DAYS=30
# Most MB waiting for one phone; more is refused with 507.
E2E_MAX_QUEUE_MB=256

# --- Shared 1 GB VPS -----------------------------------------------------------------
# Hard memory cap of the server container (swap off). Node's heap is capped at 128 MB inside the image.
SERVER_MEM_LIMIT=256m

# --- Locking out token guessing ------------------------------------------------------
# AUTH_FAIL_MAX=10
# AUTH_FAIL_WINDOW_MINUTES=10
# AUTH_LOCKOUT_MINUTES=15

# --- Slow or blocked networks (setup.sh fills these in by itself) ---------------------
# BUILD_NETWORK=host
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-slim
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2
# NPM_REGISTRY=https://registry.npmjs.org/

# --- Push (Firebase). Install the key with: sudo ./setup.sh push-key <key.json> -------
# FCM_SECRETS_DIR=./secrets
